generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  SUPER_ADMIN    // Gère toute la plateforme SaaS
  ADMIN          // Admin d'une pharmacie
  MANAGER        // Manager d'une pharmacie
  CAISSIER       // Caissier
  STOCK_MANAGER  // Gestionnaire de stock
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PharmacyStatus {
  ACTIVE         // Abonnement actif
  INACTIVE       // Désactivée manuellement
  SUSPENDED      // Suspension pour non-paiement
  PENDING        // En attente de validation
  EXPIRED        // Abonnement expiré
}

enum SubscriptionPlan {
  FREE           // Gratuit limité
  STARTER        // Démarrage
  PRO            // Professionnel
  ENTERPRISE     // Entreprise
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

enum MovementType {
  ENTRY
  SALE
  INVENTORY
  ADJUSTMENT
}

enum BatchStatus {
  ACTIVE
  EXPIRED
  DEPLETED
  RECALLED
}

enum ProductStatus {
  AVAILABLE
  OUT_OF_STOCK
  DISCONTINUED
  COMING_SOON
}

enum OrderStatus {
  PENDING          // Commande reçue, en attente de préparation
  READY            // Prête à être récupérée
  COMPLETED        // Client passé, validée et payée
  CANCELLED        // Annulée
}

enum OrderSource {
  IN_STORE         // Commande passée directement en pharmacie
  ONLINE           // Commande passée via l'interface publique
}

enum ReceptionStatus {
  PENDING
  PARTIAL
  COMPLETED
  CANCELLED
}

enum UnitType {
  PIECE
  BOX
  BOTTLE
  PACKET
  TUBE
  JAR
  VIAL
  AMPOULE
  CAPSULE
  TABLET
  ML
  LITER
  MG
  G
  KG
  SPRAY
  DROP
  PATCH
  INHALER
  SUPPOSITORY
  OTHER
}

// ==================== SUPER ADMIN ====================

model superAdmins {
  id         Int        @id @default(autoincrement())
  name       String
  email      String     @unique
  password   String
  is_active  Boolean    @default(true)
  last_login DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  activityLogs superAdminLogs[]

  @@map("super_admins")
}

model superAdminLogs {
  id          Int      @id @default(autoincrement())
  action      String
  description String?
  target_type String?  // pharmacy, subscription, user
  target_id   Int?
  ip_address  String?
  createdAt   DateTime @default(now())

  superAdminId Int
  superAdmin   superAdmins @relation(fields: [superAdminId], references: [id])

  @@index([superAdminId])
  @@index([action])
  @@index([createdAt])
  @@map("super_admin_logs")
}

// ==================== SUBSCRIPTION ====================

model subscriptions {
  id              Int                @id @default(autoincrement())
  plan            SubscriptionPlan   @default(FREE)
  status          SubscriptionStatus @default(TRIAL)
  start_date      DateTime           @default(now())
  end_date        DateTime
  trial_end_date  DateTime?
  amount          Decimal            @db.Decimal(10, 2) @default(0)
  currency        String             @default("XOF")
  auto_renew      Boolean            @default(false)
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  pharmacyId Int       @unique
  pharmacy   pharmacy  @relation(fields: [pharmacyId], references: [id])

  payments subscriptionPayments[]

  @@index([status])
  @@index([end_date])
  @@index([plan])
  @@map("subscriptions")
}

model subscriptionPayments {
  id             Int      @id @default(autoincrement())
  amount         Decimal  @db.Decimal(10, 2)
  currency       String   @default("XOF")
  method         String   // CASH, CARD, TRANSFER, MOBILE_MONEY
  reference      String?  @unique
  paid_at        DateTime @default(now())
  period_start   DateTime
  period_end     DateTime
  notes          String?
  createdAt      DateTime @default(now())

  subscriptionId Int
  subscription   subscriptions @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@index([paid_at])
  @@map("subscription_payments")
}

// ==================== PHARMACY ====================

model pharmacy {
  id             Int            @id @default(autoincrement())
  name           String
  address        String?
  phone          String?
  email          String?
  city           String?
  country        String?
  latitude       Float?
  longitude      Float?
  license_number String?        @unique
  status         PharmacyStatus @default(PENDING)
  is_active      Boolean        @default(false)
  suspended_at   DateTime?
  suspended_reason String?
  max_users      Int            @default(5)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  users          users[]
  products       products[]
  sales          sales[]
  receptions     receptions[]
  mouvements     stockMovements[]
  batches        batches[]
  orders         orders[]
  inventories    inventories[]
  auditLogs      auditLogs[]
  notifications  notifications[]
  settings       settings[]
  subscription   subscriptions?

  @@index([city])
  @@index([status])
  @@index([is_active])
  @@index([name])
}

// ==================== USERS ====================

model users {
  id         Int        @id @default(autoincrement())
  name       String
  email      String
  password   String
  role       UserRole   @default(CAISSIER)
  status     UserStatus @default(ACTIVE)
  last_login DateTime?
  phone      String?
  address    String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?

  pharmacyId     Int
  pharmacy       pharmacy         @relation(fields: [pharmacyId], references: [id])
  orders         orders[]
  receptions     receptions[]
  sales          sales[]
  products       products[]
  inventories    inventories[]
  stockMovements stockMovements[]
  auditLogs      auditLogs[]
  notifications  notifications[]

  @@unique([email, pharmacyId])
  @@index([email])
  @@index([pharmacyId, status])
  @@index([role])
  @@map("users")
}

// ==================== PRODUCTS ====================

model products {
  id               Int           @id @default(autoincrement())
  name             String
  description      String?
  stock            Float         @default(0)
  sale_price       Decimal       @db.Decimal(10, 2)
  purchase_price   Decimal       @db.Decimal(10, 2)
  threshold        Float         @default(10)
  prescription_req Boolean       @default(false)
  barcode          String
  status           ProductStatus @default(AVAILABLE)
  unit_type        UnitType      @default(PIECE)
  unit_name        String?
  unit_quantity    Float?
  subunit_type     UnitType?
  subunit_name     String?
  is_divisible     Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  userId           Int?
  categoryId       Int
  pharmacyId       Int
  user             users?             @relation(fields: [userId], references: [id])
  category         category           @relation(fields: [categoryId], references: [id])
  pharmacy         pharmacy           @relation(fields: [pharmacyId], references: [id])
  batches          batches[]
  inventories      inventories[]
  orderDetails     orderDetails[]
  receptionDetails receptionDetails[]
  saleDetails      saleDetails[]
  stockMovements   stockMovements[]
  unitConversions  unitConversions[]

  @@unique([barcode, pharmacyId])
  @@index([name])
  @@index([categoryId])
  @@index([pharmacyId])
  @@index([barcode])
  @@index([stock])
  @@index([status])
}

model category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  produit     products[]
  @@index([name])
}

model sales {
  id             Int       @id @default(autoincrement())
  sale_date      DateTime  @default(now())
  invoice_number String?   @unique
  customer       String?
  customer_phone String?
  customer_email String?
  total_amount   Decimal?  @db.Decimal(10, 2)
  discount       Decimal?  @default(0) @db.Decimal(10, 2)
  tax            Decimal?  @default(0) @db.Decimal(10, 2)
  payment_method String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  userId     Int?
  pharmacyId Int
  user       users?        @relation(fields: [userId], references: [id])
  pharmacy   pharmacy      @relation(fields: [pharmacyId], references: [id])
  details    saleDetails[]

  @@index([sale_date])
  @@index([pharmacyId])
}

model saleDetails {
  id            Int       @id @default(autoincrement())
  quantity      Float
  price         Decimal   @db.Decimal(10, 2)
  discount      Decimal?  @default(0) @db.Decimal(10, 2)
  total         Decimal?  @db.Decimal(10, 2)
  unit_type     UnitType?
  unit_name     String?
  unit_quantity Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  saleId    Int
  productId Int
  batchId   Int?
  product   products @relation(fields: [productId], references: [id])
  sale      sales    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  batch     batches? @relation(fields: [batchId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model orders {
  id                 Int         @id @default(autoincrement())
  order_date         DateTime    @default(now())
  delivery_date      DateTime?

  // Infos client
  customer           String
  customer_phone     String?
  customer_email     String?
  customer_note      String?

  // Source de la commande
  source             OrderSource @default(IN_STORE)

  // Code de retrait unique (généré pour commandes ONLINE)
  pickup_code        String?     @unique
  pickup_expires_at  DateTime?
  pickup_code_used   Boolean     @default(false)

  // Validation
  validated_by       Int?
  validated_at       DateTime?
  validated_note     String?

  status             OrderStatus @default(PENDING)
  total_amount       Decimal?    @db.Decimal(10, 2)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?

  userId     Int?
  pharmacyId Int
  user       users?         @relation(fields: [userId], references: [id])
  pharmacy   pharmacy       @relation(fields: [pharmacyId], references: [id])
  details    orderDetails[]

  @@index([pharmacyId])
  @@index([status])
  @@index([pickup_code])
  @@index([source])
}

model orderDetails {
  id        Int       @id @default(autoincrement())
  quantity  Float
  price     Decimal   @db.Decimal(10, 2)
  total     Decimal?  @db.Decimal(10, 2)
  unit_type UnitType?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  productId Int
  orderId   Int
  order     orders   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   products @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model receptions {
  id             Int             @id @default(autoincrement())
  reception_date DateTime        @default(now())
  supplier       String
  invoice_number String?
  status         ReceptionStatus @default(PENDING)
  total_amount   Decimal?        @db.Decimal(10, 2)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  userId     Int?
  pharmacyId Int
  user       users?             @relation(fields: [userId], references: [id])
  pharmacy   pharmacy           @relation(fields: [pharmacyId], references: [id])
  details    receptionDetails[]

  @@index([pharmacyId])
}

model receptionDetails {
  id            Int       @id @default(autoincrement())
  quantity      Float
  price         Decimal   @db.Decimal(10, 2)
  total         Decimal?  @db.Decimal(10, 2)
  unit_type     UnitType?
  unit_quantity Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  productId   Int
  receptionId Int
  batchId     Int?
  product     products   @relation(fields: [productId], references: [id])
  reception   receptions @relation(fields: [receptionId], references: [id], onDelete: Cascade)
  batch       batches?   @relation(fields: [batchId], references: [id])

  @@index([receptionId])
}

model batches {
  id                 Int         @id @default(autoincrement())
  number             String
  quantity           Float       @default(0)
  initial_quantity   Float
  expiration_date    DateTime
  manufacturing_date DateTime?
  status             BatchStatus @default(ACTIVE)
  unit_type          UnitType?
  unit_quantity      Float?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?

  productId        Int
  pharmacyId       Int
  product          products           @relation(fields: [productId], references: [id])
  pharmacy         pharmacy           @relation(fields: [pharmacyId], references: [id])
  saleDetails      saleDetails[]
  receptionDetails receptionDetails[]
  stockMovements   stockMovements[]

  @@unique([number, pharmacyId])
  @@index([pharmacyId])
  @@index([expiration_date])
  @@index([status])
}

model inventories {
  id             Int      @id @default(autoincrement())
  inventory_date DateTime @default(now())
  stock          Float
  expected_stock Float?
  difference     Float?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  productId  Int
  userId     Int?
  pharmacyId Int
  product    products @relation(fields: [productId], references: [id])
  user       users?   @relation(fields: [userId], references: [id])
  pharmacy   pharmacy @relation(fields: [pharmacyId], references: [id])

  @@index([pharmacyId])
}

model stockMovements {
  id             Int          @id @default(autoincrement())
  quantity       Float
  movement_date  DateTime     @default(now())
  type           MovementType
  reference_id   Int?
  reason         String?
  previous_stock Float?
  new_stock      Float?
  unit_type      UnitType?
  unit_quantity  Float?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  productId  Int
  userId     Int?
  batchId    Int?
  pharmacyId Int
  product    products @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       users?   @relation(fields: [userId], references: [id])
  batch      batches? @relation(fields: [batchId], references: [id])
  pharmacy   pharmacy @relation(fields: [pharmacyId], references: [id])

  @@index([pharmacyId])
  @@index([type])
  @@index([movement_date])
}

model unitConversions {
  id                Int      @id @default(autoincrement())
  from_unit         UnitType
  to_unit           UnitType
  conversion_factor Float
  productId         Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product products? @relation(fields: [productId], references: [id])

  @@unique([from_unit, to_unit, productId])
}

model auditLogs {
  id         Int      @id @default(autoincrement())
  action     String
  entity     String
  entity_id  Int
  old_values Json?
  new_values Json?
  ip_address String?
  user_agent String?
  createdAt  DateTime @default(now())

  userId     Int?
  pharmacyId Int?
  user       users?    @relation(fields: [userId], references: [id])
  pharmacy   pharmacy? @relation(fields: [pharmacyId], references: [id])

  @@index([pharmacyId])
  @@index([createdAt])
}

model notifications {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  type      String
  is_read   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId     Int?
  pharmacyId Int?
  user       users?    @relation(fields: [userId], references: [id])
  pharmacy   pharmacy? @relation(fields: [pharmacyId], references: [id])

  @@index([userId])
  @@index([pharmacyId])
}

model settings {
  id          Int      @id @default(autoincrement())
  key         String
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pharmacyId Int?
  pharmacy   pharmacy? @relation(fields: [pharmacyId], references: [id])

  @@unique([key, pharmacyId])
  @@index([pharmacyId])
}
