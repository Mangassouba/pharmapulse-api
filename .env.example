# Copy to .env and fill in the values (cp .env.example .env). Never commit .env.
# In production (Render), set these in the service's Environment Variables.

# ── Server ──
PORT=3000
NODE_ENV=development

# ── Database (PostgreSQL) ──
DATABASE_URL=postgresql://postgres:password@localhost:5432/pharmapulse
# true for Supabase (use the "Session pooler" URL, port 5432, without ?sslmode). Leave empty locally.
DATABASE_SSL=

# ── Security ──
# Generate each secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
JWT_RESET_EXPIRES_IN=1h
# 1 behind a proxy (Render, Nginx) to read the real visitor IP
TRUST_PROXY=

# ── Front ──
# Used in email links
FRONTEND_URL=http://localhost:5173
# Origins allowed to call the API, comma-separated
CORS_ORIGINS=http://localhost:5173

# ── Emails (SMTP) — without them the app works but no email is sent ──
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# true only with port 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com

# ── Optional ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
LOG_LEVEL=info
